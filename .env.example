# =============================================================================
# Sistema Distribuído de Monografias — variáveis de ambiente (copie para .env)
# NUNCA versione o .env. Os valores abaixo são APENAS para desenvolvimento/demo.
# =============================================================================

# --- Django (comum a todos os serviços) ---
DJANGO_SECRET_KEY=troque-esta-chave-em-producao-0123456789abcdef
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,gateway,auth-service,monografias-service,bancas-service,repositorio-service,notificacoes-service,relatorios-service
CSRF_TRUSTED_ORIGINS=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIES_SEGUROS=0
FRONTEND_URL=http://localhost:8080
LOG_LEVEL=INFO
GUNICORN_WORKERS=3

# --- PostgreSQL (um database e um usuário por serviço) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-dev-123
DB_PASSWORD_AUTH=auth-dev-123
DB_PASSWORD_MONOGRAFIAS=monografias-dev-123
DB_PASSWORD_BANCAS=bancas-dev-123
DB_PASSWORD_REPOSITORIO=repositorio-dev-123
DB_PASSWORD_NOTIFICACOES=notificacoes-dev-123
DB_PASSWORD_RELATORIOS=relatorios-dev-123

# --- Redis / RabbitMQ ---
REDIS_URL=redis://redis:6379/0
RABBITMQ_USER=tcc
RABBITMQ_PASSWORD=tcc-dev-123
RABBITMQ_URL=amqp://tcc:tcc-dev-123@rabbitmq:5672/%2F

# --- Segurança entre serviços ---
SERVICE_TOKEN=token-servico-dev-troque-me
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWKS_URL=http://auth-service:8001/.well-known/jwks.json
JWT_ACCESS_MINUTOS=15
JWT_REFRESH_DIAS=7

# Rede institucional (área administrativa). 172.28.0.1 = host Docker (acesso local via gateway).
# Para demonstrar o 403, remova 172.28.0.1/32 e recrie o auth-service.
INSTITUTIONAL_CIDRS=127.0.0.1/32,10.0.0.0/8,192.168.0.0/16,172.28.0.1/32
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# --- E-mail (MailHog) ---
EMAIL_HOST=mailhog
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=TCC <nao-responda@tcc.local>
NOTIFICACOES_ADMIN_EMAILS=admin@tcc.local

# --- URLs internas ---
AUTH_SERVICE_URL=http://auth-service:8001
MONOGRAFIAS_SERVICE_URL=http://monografias-service:8002
BANCAS_SERVICE_URL=http://bancas-service:8003
REPOSITORIO_SERVICE_URL=http://repositorio-service:8004

# --- Regras de negócio (P5/P6) ---
MAX_UPLOAD_MB=50
SUBMISSOES_POR_HORA=5
NOTA_MINIMA=6.0
BANCA_MIN_MEMBROS=3
LOGIN_MAX_FALHAS=5

# --- Throttling (valores de desenvolvimento; produção deve ser calibrada) ---
THROTTLE_ANON=60/min
GATEWAY_RATE_REPOSITORIO=200r/s
GATEWAY_BURST_REPOSITORIO=600
# O seed e a E2E concentram logins no mesmo IP de origem.
THROTTLE_LOGIN=120/min
GATEWAY_RATE_LOGIN=30r/m
GATEWAY_BURST_LOGIN=100
EXTERNO_RATE_LIMIT_POR_MIN=30

# --- Usuários de DEMONSTRAÇÃO criados por `make seed` (nunca use em produção) ---
SEED_SENHA_PADRAO=Demo@Tcc#2026
